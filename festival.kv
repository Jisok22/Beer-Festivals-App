#:kivy 2.0

<RoundedButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: '18sp'
    canvas.before:
        Color:
            rgba: 0.824, 0.412, 0.118, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]

<CancelButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: '18sp'
    canvas.before:
        Color:
            rgba: 0.290, 0.314, 0.345, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]

<FloatingAddButton@Button>:
    background_color: 0, 0, 0, 0
    color: 1, 1, 1, 1
    bold: True
    font_size: '32sp'
    canvas.before:
        Color:
            rgba: 0.824, 0.412, 0.118, 1
        Ellipse:
            pos: self.pos
            size: self.size

<StyledLabel@Label>:
    color: 1, 1, 1, 1
    font_size: '16sp'

<StyledTextInput@TextInput>:
    background_color: 0.290, 0.314, 0.345, 1
    foreground_color: 1, 1, 1, 1
    cursor_color: 0.824, 0.412, 0.118, 1
    font_size: '16sp'
    padding: [10, 10, 10, 10]

<FestivalCard@BoxLayout>:
    size_hint_y: None
    height: 80
    padding: [12, 8]
    spacing: 12
    canvas.before:
        Color:
            rgba: 0.290, 0.314, 0.345, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

<RootWidget>:
    canvas.before:
        Color:
            rgba: 0.227, 0.247, 0.278, 1
        Rectangle:
            pos: self.pos
            size: self.size